# Copy to .env next to docker-compose.yml. Every line is optional.

# The address people open. Point a DNS record (A or AAAA) at this server first.
# Leave it empty to use <server-ip>.sslip.io, which needs no DNS set-up.
DOMAIN=

# The sign-in password. Leave it empty to have one made; it is printed in the log:
#   docker compose logs studio | grep Password
PASSWORD=

# An email address for Let's Encrypt's certificate notices.
ACME_EMAIL=

# The craft apps. Each app runs unless its line says off. An app that is off isn't downloaded or
# started, and the Craft Apps extension doesn't list it. Leave at least one app on.
#PHOTOCRAFT=off
#VECTORCRAFT=off
#LIGHTCRAFT=off
#FILMCRAFT=off
#EFFECTCRAFT=off
#WORDCRAFT=off
#GRIDCRAFT=off
#DECKCRAFT=off
