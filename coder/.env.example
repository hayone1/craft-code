# Copy to .env next to docker-compose.yml. Every line is optional.

# The address, with a DNS record (A) pointing at this server. Empty: <server-ip>.sslip.io.
DOMAIN=

# The admin account that the first start creates. The password is used on the first start only:
# later changes happen in Coder (Account > Security). Empty: a password is made and printed by
# `docker compose logs setup`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# An email address for Let's Encrypt's certificate notices.
ACME_EMAIL=

# Any Coder server setting works here too: https://coder.com/docs/reference/cli/server

# Sign in with GitHub. Create an OAuth app at https://github.com/settings/developers with the
# callback URL https://<DOMAIN>/api/v2/users/oauth2/github/callback.
#CODER_OAUTH2_GITHUB_CLIENT_ID=
#CODER_OAUTH2_GITHUB_CLIENT_SECRET=
#CODER_OAUTH2_GITHUB_ALLOW_SIGNUPS=true
#CODER_OAUTH2_GITHUB_ALLOWED_ORGS=your-org

# Sign in with OpenID Connect (Google, Microsoft Entra ID, Keycloak, Authentik and others). The
# provider's redirect URL is https://<DOMAIN>/api/v2/users/oidc/callback.
#CODER_OIDC_ISSUER_URL=https://accounts.google.com
#CODER_OIDC_CLIENT_ID=
#CODER_OIDC_CLIENT_SECRET=
#CODER_OIDC_EMAIL_DOMAIN=example.com
#CODER_OIDC_SIGN_IN_TEXT=Sign in with Google

# Turn off password sign-in once single sign-on works. Keep the admin able to sign in first!
#CODER_DISABLE_PASSWORD_AUTH=true
